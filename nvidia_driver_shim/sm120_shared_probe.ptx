.version 8.8
.target sm_120a
.address_size 64

.visible .entry sm120_shared_probe(
    .param .u64 output
)
{
    .reg .pred %p;
    .reg .b32 %r<7>;
    .reg .b64 %rd<5>;
    .shared .align 4 .u32 values[32];

    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd1, %r1, 4;
    mov.u64 %rd2, values;
    add.s64 %rd3, %rd2, %rd1;
    st.shared.u32 [%rd3], %r1;
    bar.sync 0;
    setp.ne.u32 %p, %r1, 0;
    @%p bra done;
    mov.u32 %r2, 0;
    mov.u32 %r3, 0;
loop:
    mul.wide.u32 %rd1, %r2, 4;
    add.s64 %rd3, %rd2, %rd1;
    ld.shared.u32 %r4, [%rd3];
    add.u32 %r3, %r3, %r4;
    add.u32 %r2, %r2, 1;
    setp.lt.u32 %p, %r2, 32;
    @%p bra loop;
    ld.param.u64 %rd4, [output];
    st.global.u32 [%rd4], %r3;

done:
    ret;
}
