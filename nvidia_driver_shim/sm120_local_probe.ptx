.version 8.8
.target sm_120a
.address_size 64

.visible .entry sm120_local_probe(
    .param .u64 output
)
{
    .reg .pred %p;
    .reg .b32 %r<8>;
    .reg .b64 %rd<5>;
    .local .align 4 .b8 scratch[32];

    mov.u32 %r1, %tid.x;
    mov.u32 %r5, %ctaid.x;
    mov.u32 %r6, %ntid.x;
    mad.lo.u32 %r0, %r5, %r6, %r1;
    and.b32 %r2, %r1, 7;
    mul.wide.u32 %rd1, %r2, 4;
    mov.u64 %rd2, scratch;
    add.s64 %rd3, %rd2, %rd1;
    add.u32 %r3, %r0, 7;
    st.local.u32 [%rd3], %r3;
    ld.local.u32 %r4, [%rd3];
    ld.param.u64 %rd4, [output];
    mul.wide.u32 %rd1, %r0, 4;
    add.s64 %rd4, %rd4, %rd1;
    st.global.u32 [%rd4], %r4;
    ret;
}
