#!/usr/bin/env bpftrace

BEGIN
{
    printf("target_pid=%d\n", cpid);
}

tracepoint:syscalls:sys_enter_openat
/pid == cpid/
{
    @open_start[tid] = nsecs;
    @open_path[tid] = str(args.filename);
}

tracepoint:syscalls:sys_exit_openat
/pid == cpid && @open_start[tid]/
{
    $duration_us = (nsecs - @open_start[tid]) / 1000;
    @open_us[@open_path[tid]] = stats($duration_us);
    delete(@open_start[tid]);
    delete(@open_path[tid]);
}

tracepoint:syscalls:sys_enter_ioctl
/pid == cpid/
{
    @ioctl_start[tid] = nsecs;
    @ioctl_cmd[tid] = args.cmd;
}

tracepoint:syscalls:sys_exit_ioctl
/pid == cpid && @ioctl_start[tid]/
{
    $duration_us = (nsecs - @ioctl_start[tid]) / 1000;
    @ioctl_us[@ioctl_cmd[tid]] = stats($duration_us);
    @ioctl_hist_us[@ioctl_cmd[tid]] = hist($duration_us);
    delete(@ioctl_start[tid]);
    delete(@ioctl_cmd[tid]);
}

END
{
    clear(@open_start);
    clear(@open_path);
    clear(@ioctl_start);
    clear(@ioctl_cmd);
}
