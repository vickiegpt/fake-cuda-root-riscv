    mad.lo.u32 %r6, %r3, %r4, %r5;
    setp.ge.u32 %p1, %r6, %r1;
    @%p1 bra convert_done;

    mul.wide.u32 %rd8, %r6, 4;
    add.s64 %rd9, %rd6, %rd8;
